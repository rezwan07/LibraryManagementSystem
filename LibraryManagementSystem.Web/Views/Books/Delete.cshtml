@model LibraryManagementSystem.Services.DTOs.BookDTO
@{
    ViewData["Title"] = "Delete Book";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">

            <div class="card-header bg-danger text-white">
                <h3 class="mb-0">⚠️ Confirm Delete</h3>
            </div>

            <div class="card-body">
                <h5>Are you sure you want to delete this book?</h5>
                <hr />

                <dl class="row">
                    <dt class="col-sm-4">Title</dt>
                    <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                    <dt class="col-sm-4">Author</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8"><code>@Model.ISBN</code></dd>
                </dl>

                @if (Model.BorrowedCopies > 0)
                {
                    <div class="alert alert-warning">
                        ⚠️ This book has <strong>@Model.BorrowedCopies</strong> copies currently borrowed.
                        You cannot delete it until all copies are returned.
                    </div>
                }
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id"/>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">cancel</a>
                        <button type="submit"
                                class="btn btn-danger"
                                @(Model.BorrowedCopies > 0 ? "Disabled" : "")>
                            🗑️ Yes, Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>