@{
    ViewData["Title"] = "Home";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        ✅ @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="text-center mt-5">
    <h1 class="display-4">📚 Library Management System</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="lead">
            Welcome, <strong>@User.FindFirst("FullName")?.Value</strong>!
            <span class="badge bg-primary">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
        </p>
        <div class="mt-4">
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">
                Browse Books
            </a>
        </div>
    }
    else
    {
        <p class="lead">Please login to continue</p>
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg">Register</a>
        </div>
    }
</div>